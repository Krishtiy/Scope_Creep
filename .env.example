# Scope-Creep Catcher Environment Variables
# Copy this file to .env and fill in your keys when ready.

# Backboard.io API Key (Partner technology for cloud evaluation on larger open models)
# 1. Sign up at https://app.backboard.io
# 2. Claim your Hacktoberfest free credits at https://hacktoberfest.com/my/promos
# 3. Create an API key in your Backboard dashboard
# 4. Paste it below:
BACKBOARD_API_KEY=

# Sentry DSN (Optional P2, disabled by default)
# ENABLE_SENTRY=0
# SENTRY_DSN=
